      "order_index": 8,
      "content": "1.2 Goals & Business Objectives",
      "page_number": null,
      "bbox": null,
      "level": 3,
      "language": null,
      "items": null,
      "ordered": null,
      "list_start_number": null,
      "image_id_ref": null,
