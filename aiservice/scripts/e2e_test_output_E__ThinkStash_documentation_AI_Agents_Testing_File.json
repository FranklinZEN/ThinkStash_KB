    {
      "block_id": "bf7d621e-76b6-4b17-b2f1-261a62b4a5bd",
      "tmp_id": "34e045e7-f8e2-57a6-8adb-6a8c004a7c42_md_b4_p",
      "user_id": "default_e2e_user",
      "document_id": "34e045e7-f8e2-57a6-8adb-6a8c004a7c42",
      "type": "text",
      "order_index": 4,
      "content": "This document outlines the requirements for the Web-Based Knowledge Card System, a platform designed to help knowledge workers, professionals, researchers, and educators capture, organize, discover, synthesize, and utilize information effectively. Users can create rich, multimedia \"knowledge cards,\" organize them into hierarchical folders, retrieve information through powerful search, visualize connections, interact conversationally, and actively generate new ideas from their knowledge base using AI.",
      "page_number": null,
      "bbox": null,
      "level": null,
      "language": null,
      "items": null,
      "ordered": null,
      "list_start_number": null,
      "image_id_ref": null,
      "gcs_url": null,
      "alt_text": null,
      "caption": null,
      "llm_description": null,
      "width": null,
      "height": null
    },
    {
      "block_id": "99ac94a0-9f41-4629-a382-c932197822dd",
      "tmp_id": "34e045e7-f8e2-57a6-8adb-6a8c004a7c42_md_b5",
      "user_id": "default_e2e_user",
      "document_id": "34e045e7-f8e2-57a6-8adb-6a8c004a7c42",
      "type": "list",
      "order_index": 5,
      "content": null,
      "page_number": null,
      "bbox": null,
      "level": null,
      "language": null,
      "items": [
        "Stage 1 (Completed): Focused on a local/offline-capable MVP for core capture and organization.",
        "Stage 2 (Current Focus): Transitions to a production-ready application on Google Cloud Platform (GCP), introduces core AI-driven content creation and enhancement features using CrewAI, implements a manual hashtagging system, overhauls the UI/UX for production, and includes a database rethink for scalability.",
        "Stage 2+ (Future): Builds further with advanced search, interaction features like RAG chat, basic dashboard statistics, and more sophisticated AI capabilities."
      ],
      "ordered": false,
