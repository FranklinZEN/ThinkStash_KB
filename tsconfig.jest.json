{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "esModuleInterop": true, 
    "module": "commonjs" // ts-jest often works best when it emits CommonJS for Jest Node env
  },
  "exclude": [
    "node_modules", 
    ".next"
  ],
  "include": [
    "**/*.test.ts", 
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "jest.setup.js",
    "jest.setup.backend.js" // Also include backend setup if it's a .ts file (it's .js for us now)
  ]
} 