from crewai import Agent, Task
from typing import List, Type
from pydantic import BaseModel

class PDFContentAcquisitionAgent:
    def __init__(self, tools: List[BaseModel] = None): self.tools = tools or []
    def pdf_acquisition_agent(self) -> Agent: return Agent(role='PDF Agent', goal='Process PDFs', backstory='...', tools=self.tools, verbose=True, allow_delegation=False)

class GenericFileContentAcquisitionAgent:
    def __init__(self, tools: List[BaseModel] = None): self.tools = tools or []
    def generic_file_acquisition_agent(self) -> Agent: return Agent(role='Generic File Agent', goal='Process DOCX, TXT, MD', backstory='...', tools=self.tools, verbose=True, allow_delegation=False)

class ImageProcessingPersistenceAgent:
    def __init__(self, tools: List[BaseModel] = None): self.tools = tools or []
    def image_processing_agent(self) -> Agent: return Agent(role='Image Processor', goal='Process images and upload to GCS', backstory='...', tools=self.tools, verbose=True, allow_delegation=False)

