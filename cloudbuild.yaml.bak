# Top-level availableSecrets defines how secrets map to ENV VARS for steps.
availableSecrets:
  secretManager:
    - versionName: projects/${_PROJECT_ID}/secrets/kc-db-user/versions/latest
      env: 'DB_USER'
    - versionName: projects/${_PROJECT_ID}/secrets/kc-db-password/versions/latest
      env: 'DB_PASSWORD'
    - versionName: projects/${_PROJECT_ID}/secrets/kc-db-name/versions/latest
      env: 'DB_NAME'
    # Add secrets for Playwright and app runtime for E2E
    - versionName: projects/${_PROJECT_ID}/secrets/TEST_USER_EMAIL/versions/latest # You'll need to create this secret
      env: 'TEST_USER_EMAIL'
    - versionName: projects/${_PROJECT_ID}/secrets/TEST_USER_PASSWORD/versions/latest # You'll need to create this secret
      env: 'TEST_USER_PASSWORD'
    - versionName: projects/${_PROJECT_ID}/secrets/NEXTAUTH_URL/versions/latest # You'll need to create this secret
      env: 'NEXTAUTH_URL' # Should be the deployed URL for E2E, or http://localhost:3000 if testing locally within build
    - versionName: projects/${_PROJECT_ID}/secrets/NEXTAUTH_SECRET/versions/latest
      env: 'NEXTAUTH_SECRET'
    - versionName: projects/${_PROJECT_ID}/secrets/GCS_MEDIA_BUCKET_NAME/versions/latest
      env: 'GCS_MEDIA_BUCKET_NAME'
    # Add other secrets your app needs at runtime for E2E, like a specific DATABASE_URL for E2E tests if needed

steps:
# Step 1: Install Dependencies
- name: 'node:20-slim'
  entrypoint: 'npm'
  args: ['ci'] # Use 'ci' for cleaner installs in CI
  id: 'Install Dependencies'

# Step 2: Lint
- name: 'node:20-slim'
  entrypoint: 'npm'
  args: ['run', 'lint']
  id: 'Lint'
  waitFor: ['Install Dependencies']

# Step 3: Vitest Unit & Integration Tests (and Coverage)
# This step might need its own DATABASE_URL if integration tests hit a live test DB.
# For now, assuming Prisma is mocked or tests don't require a live DB here.
- name: 'node:20-slim'
  entrypoint: 'npm'
  args: ['run', 'coverage'] # Runs 'vitest run --coverage'
  id: 'Vitest Tests and Coverage'
  waitFor: ['Lint']
  # env: # Example if a specific test DB URL is needed for Vitest integration tests
  #   - 'DATABASE_URL=postgresql://${DB_USER_TEST}:${DB_PASSWORD_TEST}@test-db-host:5432/${DB_NAME_TEST}'

# Step 4: Build Prisma Client (might be implicitly handled by `npm run build` if in `postinstall` or build script)
- name: 'node:20-slim'
  entrypoint: 'npm'
  args: ['run', 'prisma:generate']
  id: 'Build Prisma Client'
  waitFor: ['Vitest Tests and Coverage'] # Ensure tests pass before building

# Step 5: Build Next.js app (for E2E tests and deployment)
- name: 'node:20-slim'
  entrypoint: 'npm'
  args: ['run', 'build']
  id: 'Build Next.js app'
  waitFor: ['Build Prisma Client']
  # Pass build-time env vars if necessary
  # env:
  #   - 'NEXT_PUBLIC_SOME_VAR=value'

# Step 6: Install Playwright Browsers & Dependencies
# Using a Microsoft-provided Playwright image which includes Node.
# This ensures browsers and their OS dependencies are present.
- name: 'mcr.microsoft.com/playwright:v1.45.0-jammy' # Check for latest Playwright image version
  id: 'Install Playwright Browsers'
  entrypoint: 'npx'
  args: ['playwright', 'install', '--with-deps']
  waitFor: ['Build Next.js app'] # Browsers needed after build if E2E runs against built app

# Step 7: Run Playwright E2E Tests
# This step will use the webServer config in playwright.config.ts to start the app.
# The app started by webServer (e.g., via `npm run start`) will need runtime env vars.
- name: 'mcr.microsoft.com/playwright:v1.45.0-jammy'
  id: 'Run E2E Tests'
  entrypoint: 'npm'
  args: ['run', 'test:e2e']
  waitFor: ['Install Playwright Browsers']
  secretEnv: # Secrets for global.setup.ts (Playwright login)
    - 'TEST_USER_EMAIL'
    - 'TEST_USER_PASSWORD'
    - 'NEXTAUTH_URL'
  env: # Runtime environment variables for your Next.js app when started by Playwright's webServer
    - 'NODE_ENV=production' # Or 'development' if webServer uses npm run dev
    - 'NEXTAUTH_SECRET=${NEXTAUTH_SECRET}' # Pass the secret value
    - 'GCS_MEDIA_BUCKET_NAME=${GCS_MEDIA_BUCKET_NAME}'
    # IMPORTANT: DATABASE_URL for the E2E tests.
    # This should point to the database that migrations in Step 9 will run against,
    # or a dedicated E2E test database if you set one up.
    # If migrations in step 9 prepare your target DB, this DATABASE_URL should match that.
    # For instance, if migrations target your actual dev/staging DB via proxy:
    - 'DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}?sslmode=disable' # Assumes proxy will be up for app
    # This DATABASE_URL is tricky because the app for E2E might need the proxy too if it's not connecting to a containerized DB.
    # Consider if E2E should run before or after migrations, or if it needs its own DB setup.
    # A common pattern for E2E is to test against an environment that is *already* migrated and deployed (staging).
    # If testing within the build pipeline before deployment, careful DB management is needed.

# Step 8: Build Docker image (moved after E2E tests pass)
- name: 'gcr.io/cloud-builders/docker'
  args: [
    'build',
    '-t',
    '${_GCP_REGION}-docker.pkg.dev/${_PROJECT_ID}/${_ARTIFACT_REGISTRY_REPO}/kc-nextjs-backend:$COMMIT_SHA',
    '.'
  ]
  id: 'Build Docker image'
  waitFor: ['Run E2E Tests'] # Only build image if all tests pass

# Step 9: Push Docker image to Artifact Registry
- name: 'gcr.io/cloud-builders/docker'
  args: ['push', '${_GCP_REGION}-docker.pkg.dev/${_PROJECT_ID}/${_ARTIFACT_REGISTRY_REPO}/kc-nextjs-backend:$COMMIT_SHA']
  id: 'Push Docker image'
  waitFor: ['Build Docker image']

# Step 10: Run Migrations with Proxy (largely same as your existing step)
# This step assumes you are migrating your target deployment database.
- name: '${_GCP_REGION}-docker.pkg.dev/${_PROJECT_ID}/${_ARTIFACT_REGISTRY_REPO}/kc-nextjs-backend:$COMMIT_SHA'
  id: 'Run Migrations with Proxy'
  waitFor: ['Push Docker image']
  secretEnv:
    - 'DB_USER'
    - 'DB_PASSWORD'
    - 'DB_NAME'
  entrypoint: 'sh'
  args:
    - '-c'
    - |
      set -e
      echo "Step 10: Preparing for database migration..."
      PROXY_VERSION="v2.10.0"
      PROXY_ARCH="linux.amd64"
      PROXY_DOWNLOAD_URL="https://storage.googleapis.com/cloud-sql-connectors/cloud-sql-proxy/$${PROXY_VERSION}/cloud-sql-proxy.$${PROXY_ARCH}"
      PROXY_PATH="/tmp/cloud-sql-proxy"
      echo "Downloading Cloud SQL Proxy version $${PROXY_VERSION}..."
      wget -q "$${PROXY_DOWNLOAD_URL}" -O "$${PROXY_PATH}"
      chmod +x "$${PROXY_PATH}"
      echo "Starting Cloud SQL Proxy in background for instance: ${_DB_INSTANCE_CONNECTION_NAME}..."
      "$${PROXY_PATH}" "${_DB_INSTANCE_CONNECTION_NAME}" --address=0.0.0.0 --port=5432 --structured-logs &
      PROXY_PID=$!
      echo "Proxy started in background with PID $${PROXY_PID}."
      echo "Sleeping 15 seconds for proxy to fully initialize..."
      sleep 15
      echo "Setting DATABASE_URL and running Prisma migrations..."
      export DATABASE_URL="postgresql://$${DB_USER}:$${DB_PASSWORD}@localhost:5432/$${DB_NAME}?sslmode=disable"
      echo "DATABASE_URL set to: [$${DATABASE_URL}]"
      npx prisma migrate deploy
      echo "Prisma migrations finished."
      echo "Attempting to gracefully kill Cloud SQL Proxy (PID $${PROXY_PID})..."
      kill $${PROXY_PID} || echo "Proxy (PID $${PROXY_PID}) already exited or failed to kill."
      sleep 2
      if kill -0 $${PROXY_PID} > /dev/null 2>&1; then
        echo "Proxy (PID $${PROXY_PID}) did not terminate gracefully after kill, sending SIGKILL."
        kill -9 $${PROXY_PID} || echo "Failed to send SIGKILL or proxy already exited."
      else
        echo "Proxy (PID $${PROXY_PID}) terminated or was already stopped."
      fi
      echo "Proxy and migration step complete."

# Step 11: Deploy to Cloud Run (largely same as your existing step)
- name: 'gcr.io/google.com/cloudsdktool/cloud-sdk:slim'
  id: 'Deploy to Cloud Run'
  waitFor: ['Run Migrations with Proxy'] # Or 'Push Docker image' if migrations are managed separately/manually
  entrypoint: gcloud
  args: [
    'run',
    'deploy',
    '${_CLOUD_RUN_SERVICE_NAME}',
    '--image=${_GCP_REGION}-docker.pkg.dev/${_PROJECT_ID}/${_ARTIFACT_REGISTRY_REPO}/kc-nextjs-backend:$COMMIT_SHA',
    '--region=${_GCP_REGION}',
    '--platform=managed',
    '--allow-unauthenticated',
    '--service-account=${_CLOUD_RUN_SA_EMAIL}',
    '--update-secrets=DB_USER=kc-db-user:latest,DB_PASSWORD=kc-db-password:latest,DB_NAME=kc-db-name:latest,DB_HOST_PATH=kc-db-host-path:latest,NEXTAUTH_SECRET=nextauth-secret:latest,GCS_MEDIA_BUCKET_NAME=kc-gcs-media-bucket-name:latest'
    # Add any new secrets needed by the app at runtime, like TEST_USER_EMAIL etc. if those are actually needed by the *deployed app* (usually not)
  ]

# Artifacts to store
artifacts:
  objects:
    location: 'gs://${_ARTIFACT_BUCKET}/build-artifacts/$BUILD_ID/' # Changed path slightly for clarity
    paths:
      - 'playwright-report/**'       # Playwright HTML report
      - 'test-results/**'            # Playwright traces on failure, JUnit XML if configured
      - 'coverage/lcov-report/**'    # Vitest LCOV coverage HTML report
      - 'coverage/coverage-final.json' # Vitest JSON coverage summary
      # - 'results.xml' # If you configure JUnit reporter for Playwright

options:
  logging: CLOUD_LOGGING_ONLY

# Define substitutions (you likely have these already)
# substitutions:
#   _PROJECT_ID: your-gcp-project-id
#   _GCP_REGION: your-gcp-region
#   _ARTIFACT_REGISTRY_REPO: your-repo-name
#   _DB_INSTANCE_CONNECTION_NAME: project:region:instance
#   _CLOUD_RUN_SERVICE_NAME: your-service-name
#   _CLOUD_RUN_SA_EMAIL: your-service-account-email
#   _ARTIFACT_BUCKET: your-gcs-bucket-for-artifacts