{
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "analyze": "cross-env ANALYZE=true npm run build",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=true eslint src/ pages/ lib/ --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "test:jest": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs",
    "test:jest:fe": "npx jest --watch",
    "test:jest:be": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest --config jest.config.backend.js --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@blocknote/core": "0.31.0",
    "@blocknote/mantine": "0.31.0",
    "@blocknote/react": "0.31.0",
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^2.8.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@google-cloud/error-reporting": "^3.0.5",
    "@google-cloud/storage": "7.7.0",
    "@mantine/core": "^7.17.4",
    "@mantine/hooks": "^7.17.4",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^3.0.2",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.9.2",
    "lucide-react": "^0.511.0",
    "next-auth": "^4.24.11",
    "pg": "^8.14.1",
    "react-flow": "^1.0.3",
    "react-icons": "^5.5.0",
    "uuid": "^9.0.1",
    "zod": "^3.24.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.3.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "22.14.1",
    "@types/react": "19.1.2",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/ui": "^3.1.4",
    "cross-env": "^7.0.3",
    "cross-fetch": "^4.1.0",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.3.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "happy-dom": "^17.4.7",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-mock-extended": "^3.0.7",
    "jest-silent-reporter": "^0.6.0",
    "lint-staged": "^15.5.1",
